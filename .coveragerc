[run]
relative_files = true
source = TraceLens
omit =
    TraceLens/EventReplay/*
    TraceLens/PerfModel/benchmarking/*
    TraceLens/PerfModel/origami_helper.py
    TraceLens/PerfModel/run_perf_model.py
    # Manual validation script: exercises the resolver against a real framework
    # install (needs vllm/aiter/sglang present), so it can't run in unit CI.
    TraceLens/TraceUtils/kernel_source/validate.py

[paths]
source =
    TraceLens/
    */TraceLens/
    /__w/TraceLens/TraceLens/TraceLens/

[report]
show_missing = true
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__.:
    raise NotImplementedError
    if TYPE_CHECKING:

[xml]
output = coverage.xml
