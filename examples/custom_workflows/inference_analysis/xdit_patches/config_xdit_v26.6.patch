+    def _run_compile_warmup(self, compile_args: dict) -> None:
+        """Run the compile warmup, optionally capturing a profiler trace.
+
+        For reduce-overhead mode (CUDA graphs), torch.compile uses a three-phase
+        warmup: (1) eager warmup, (2) CUDA graph recording, (3) CUDA graph replay.
+        When --profile_capture_phase is enabled, this method splits the warmup so
+        the profiler is active during phase 2 (CUDA graph recording), capturing
+        individual kernel launches with shapes and call stacks rather than opaque
+        cudaGraphLaunch calls.
+
+        For default mode (no CUDA graphs), the profiler captures individual kernels
+        on any pass, so no splitting is needed.
+        """
+        enable_capture = (
+            self.config.profile_capture_phase
+            and get_world_group().rank == 0
+            and self._get_compile_mode() == "reduce-overhead"
+        )
+        if not enable_capture:
+            self._run_timed_pipe(compile_args)
+            return
+
+        # Phase 1: Dynamo trace + Inductor compile + eager warmup (1 step).
+        compile_args["num_inference_steps"] = 1
+        self._run_timed_pipe(compile_args)
+
+        # Phase 2: CUDA graph recording under profiler (1 step).
+        capture_args = copy.deepcopy(compile_args)
+        capture_args["num_inference_steps"] = 1
+        log("Profiling CUDA graph recording phase for shape trace...")
+        capture_dir = f"{self.config.output_directory}/capture_traces"
+        os.makedirs(capture_dir, exist_ok=True)
+        capture_path = f"{capture_dir}/capture_trace_rank_0.json.gz"
+        with profile(
+            activities=[ProfilerActivity.CPU, ProfilerActivity.CUDA],
+            record_shapes=True,
+            with_stack=True,
+            on_trace_ready=lambda prof: prof.export_chrome_trace(capture_path),
+        ) as capture_prof:
+            self._run_timed_pipe(capture_args)
+        log(f"Capture trace saved to {capture_path}")
+
     def get_output_name(self, input_args) -> str:
