+
+    def compute_detailed_aggregates(
+        self,
+        scheduled_batch: ScheduledBatch,
+        seqs: dict[int, Sequence],
+    ) -> None:
+        """Store per-batch attention aggregates on *scheduled_batch*.
+
+        Only the quadratic terms a downstream attention-FLOP estimate actually
+        needs are computed here. Request counts and total query tokens are
+        already carried by the ``prefill[]``/``decode[]`` labels emitted in
+        :meth:`ModelRunner.run_model`, so this avoids duplicating them.
+
+            sqsq  - sum of N_Q^2      (per request)
+            sqsk  - sum of N_Q*N_KV   (per request)
+            sk    - sum of N_KV       (per request)
+
+        ``N_Q`` is the number of query tokens scheduled for a request and
+        ``N_KV`` its KV length (cached + new tokens for prefill, full sequence
+        length for decode). Summing over every request in the batch gives the
+        total for one forward. For MTP/spec-decode a decode step schedules
+        ``mtp_k + 1`` query tokens, so the scheduled token count is used as
+        ``N_Q`` for both branches rather than a hardcoded 1.
+
+        No-op (leaves the fields ``None``) unless profiling is active and
+        ``ATOM_ENABLE_DETAILED_ANNOTATION`` is set.
+        """
+        if not self.profile_active or not self._detailed_annotation_enabled:
+            return
+
+        sqsq = 0  # sum N_Q^2
+        sqsk = 0  # sum N_Q*N_KV
+        sk = 0  # sum N_KV
+        for seq, num_tokens in zip(seqs.values(), scheduled_batch.num_scheduled_tokens):
+            # Cast to Python int: num_scheduled_tokens is np.int32, so nq*nq
+            # would overflow once a prefill chunk exceeds ~46341 tokens
+            # (np.int32(65536)**2 == 0), silently corrupting the estimate.
+            nq = int(num_tokens)
+            if seq.type == SequenceType.DECODE:
+                nkv = int(seq.num_tokens)  # full sequence length
+            else:
+                # PREFILL: KV length = cached + new tokens.
+                nkv = int(seq.num_cached_tokens) + nq
+            sqsq += nq * nq
+            sqsk += nq * nkv
+            sk += nkv
+
+        scheduled_batch.detailed_sqsq = sqsq
+        scheduled_batch.detailed_sqsk = sqsk
+        scheduled_batch.detailed_sk = sk
