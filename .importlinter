[importlinter]
root_packages =
    TraceLens

[importlinter:contract:acyclic-tracelens]
name = No circular dependencies in TraceLens
type = acyclic_siblings
ancestors =
    TraceLens
depth = 10
ignore_imports =
    TraceLens.ModelUtils.basic_ops -> TraceLens.ModelUtils.block_tree
    TraceLens.ModelUtils.blocks -> TraceLens.ModelUtils.ast_analyze
    TraceLens.ModelUtils.block_tree -> TraceLens.ModelUtils.computation_graph
    TraceLens.ModelUtils.ast_analyze -> TraceLens.ModelUtils.kernel_pipeline
    TraceLens.ModelUtils.model_graph -> TraceLens.ModelUtils.computation_graph
    TraceLens.Trace2Tree.trace_capture_merge_experimental -> TraceLens.TraceUtils.utils.annotation_utils
    TraceLens.TraceUtils.split_trace.root_detection -> TraceLens.Trace2Tree.trace_to_tree
    TraceLens.TraceUtils.split_trace.root_detection -> TraceLens.Trace2Tree.util

[importlinter:contract:modelutils-does-not-import-visualizer]
name = ModelUtils does not import the Visualizer
type = forbidden
source_modules =
    TraceLens.ModelUtils
forbidden_modules =
    TraceLens.Visualizer
